# Public site URL (used for canonical URLs, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://nanhimindforge.com

# Contact form email delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Nanhi AI Mindforge <website@nanhimindforge.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries (defaults to the address in src/content/site.ts)
CONTACT_TO_EMAIL=
